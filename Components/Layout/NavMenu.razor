<div class="brand">
    <span class="brand-mark">₴</span>
    <div>
        <strong>Мои финансы</strong>
        <small>Личный бюджет</small>
    </div>
</div>

<nav class="nav-links">
    <NavLink href="/" Match="NavLinkMatch.All">
        <span>⌂</span> Обзор
    </NavLink>
    <NavLink href="transactions">
        <span>↕</span> Операции
    </NavLink>
    <NavLink href="categories">
        <span>▦</span> Категории
    </NavLink>
</nav>

<AuthorizeView>
    <Authorized Context="auth">
        <div class="user-panel">
            <span title="@auth.User.Identity?.Name">@auth.User.Identity?.Name</span>
            <form method="post" action="/account/actions/logout">
                <AntiforgeryToken />
                <button type="submit">Выйти</button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>
