@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<FinanceDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Обзор — Мои финансы</PageTitle>

<header class="page-header">
    <div>
        <p class="eyebrow">Финансовая сводка</p>
        <h1>Обзор за @MonthTitle</h1>
        <p class="subtitle">Доходы, расходы и последние операции в одном месте.</p>
    </div>
    <a class="button primary" href="transactions/new">+ Добавить операцию</a>
</header>

@if (isLoading)
{
    <div class="loading">Загружаем данные…</div>
}
else
{
    <section class="summary-grid">
        <article class="summary-card balance">
            <span>Баланс за месяц</span>
            <strong>@Money(balance)</strong>
            <small>Доходы минус расходы</small>
        </article>
        <article class="summary-card income">
            <span>Доходы</span>
            <strong>+@Money(income)</strong>
            <small>@incomeCount операций</small>
        </article>
        <article class="summary-card expense">
            <span>Расходы</span>
            <strong>−@Money(expense)</strong>
            <small>@expenseCount операций</small>
        </article>
    </section>

    @if (budgetStatuses.Count > 0)
    {
        <section class="panel budget-overview">
            <div class="panel-heading">
                <div>
                    <h2>Бюджеты месяца</h2>
                    <p>@BudgetOverviewText</p>
                </div>
                <a href="budgets">Настроить лимиты</a>
            </div>
            <div class="budget-overview-grid">
                @foreach (var budget in budgetStatuses)
                {
                    <div class="budget-mini-card @(budget.IsExceeded ? "exceeded" : budget.IsNearLimit ? "near-limit" : "")">
                        <div class="budget-row-heading">
                            <span><i style="background: @budget.Color"></i>@budget.CategoryName</span>
                            <strong>@budget.Percent%</strong>
                        </div>
                        <div class="budget-track"><div class="budget-fill" style="width: @budget.ProgressWidth%; background: @budget.BarColor"></div></div>
                        <small>@budget.StatusText</small>
                    </div>
                }
            </div>
        </section>
    }

    <section class="panel monthly-expenses-panel">
        <div class="panel-heading">
            <div>
                <h2>Расходы по месяцам</h2>
                <p>Динамика расходов за последние 6 месяцев</p>
            </div>
            <strong class="monthly-expenses-total">@Money(monthlyExpenses.Sum(x => x.Amount))</strong>
        </div>

        @if (monthlyExpenses.All(x => x.Amount == 0))
        {
            <div class="empty-compact">За последние 6 месяцев расходов пока нет.</div>
        }
        else
        {
            <div class="monthly-chart" role="img" aria-label="Диаграмма расходов по месяцам за последние 6 месяцев">
                @foreach (var month in monthlyExpenses)
                {
                    <div class="monthly-chart-column" title="@month.FullLabel: @Money(month.Amount)">
                        <strong>@MoneyCompact(month.Amount)</strong>
                        <div class="monthly-chart-track">
                            <div class="monthly-chart-bar" style="height: @MonthlyBarHeight(month.Amount)%"></div>
                        </div>
                        <span>@month.Label</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-heading">
                <div>
                    <h2>Расходы по категориям</h2>
                    <p>Структура расходов текущего месяца</p>
                </div>
            </div>

            @if (expensesByCategory.Count == 0)
            {
                <div class="empty-compact">В этом месяце расходов пока нет.</div>
            }
            else
            {
                <div class="category-chart">
                    @foreach (var item in expensesByCategory)
                    {
                        <div class="chart-row">
                            <div class="chart-label">
                                <span><i style="background: @item.Color"></i>@item.Name</span>
                                <strong>@Money(item.Amount)</strong>
                            </div>
                            <div class="chart-track">
                                <div class="chart-fill" style="width: @Percent(item.Amount)%; background: @item.Color"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-heading">
                <div>
                    <h2>Последние операции</h2>
                    <p>Недавние движения средств</p>
                </div>
                <a href="transactions">Все операции</a>
            </div>

            @if (recentTransactions.Count == 0)
            {
                <div class="empty-compact">Добавьте первую операцию.</div>
            }
            else
            {
                <div class="recent-list">
                    @foreach (var transaction in recentTransactions)
                    {
                        var isIncome = transaction.Category?.Type == TransactionType.Income;
                        <a class="recent-item" href="transactions/edit/@transaction.Id">
                            <i style="background: @transaction.Category?.Color"></i>
                            <div>
                                <strong>@transaction.Description</strong>
                                <small>@transaction.Category?.Name · @transaction.Date.ToString("dd MMM")</small>
                            </div>
                            <span class="@(isIncome ? "money-in" : "money-out")">
                                @(isIncome ? "+" : "−")@Money(transaction.Amount)
                            </span>
                        </a>
                    }
                </div>
            }
        </article>
    </section>
}

@code {
    private bool isLoading = true;
    private decimal income;
    private decimal expense;
    private decimal balance;
    private int incomeCount;
    private int expenseCount;
    private List<CategoryTotal> expensesByCategory = [];
    private List<FinanceTransaction> recentTransactions = [];
    private List<BudgetStatus> budgetStatuses = [];
    private List<MonthlyExpense> monthlyExpenses = [];

    private string MonthTitle => DateTime.Today.ToString("MMMM yyyy");
    private string BudgetOverviewText
    {
        get
        {
            var exceeded = budgetStatuses.Count(x => x.IsExceeded);
            var near = budgetStatuses.Count(x => x.IsNearLimit);
            if (exceeded > 0) return $"Превышено лимитов: {exceeded}";
            if (near > 0) return $"Близко к лимиту: {near}";
            return "Расходы укладываются в заданные лимиты";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.GetRequiredUserId();
        await using var db = await DbFactory.CreateDbContextAsync();
        var monthStart = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
        var nextMonth = monthStart.AddMonths(1);

        var monthTransactions = await db.Transactions
            .AsNoTracking()
            .Include(x => x.Category)
            .Where(x => x.UserId == userId && x.Date >= monthStart && x.Date < nextMonth)
            .ToListAsync();

        income = monthTransactions
            .Where(x => x.Category!.Type == TransactionType.Income)
            .Sum(x => x.Amount);
        expense = monthTransactions
            .Where(x => x.Category!.Type == TransactionType.Expense)
            .Sum(x => x.Amount);
        incomeCount = monthTransactions.Count(x => x.Category!.Type == TransactionType.Income);
        expenseCount = monthTransactions.Count(x => x.Category!.Type == TransactionType.Expense);
        balance = income - expense;

        expensesByCategory = monthTransactions
            .Where(x => x.Category!.Type == TransactionType.Expense)
            .GroupBy(x => new { x.Category!.Name, x.Category.Color })
            .Select(group => new CategoryTotal(group.Key.Name, group.Key.Color, group.Sum(x => x.Amount)))
            .OrderByDescending(x => x.Amount)
            .ToList();

        var budgets = await db.MonthlyBudgets
            .AsNoTracking()
            .Include(x => x.Category)
            .Where(x => x.UserId == userId && x.Month == monthStart)
            .OrderBy(x => x.Category!.Name)
            .ToListAsync();
        var spentByCategory = monthTransactions
            .Where(x => x.Category!.Type == TransactionType.Expense)
            .GroupBy(x => x.CategoryId)
            .ToDictionary(x => x.Key, x => x.Sum(t => t.Amount));
        budgetStatuses = budgets.Select(x => new BudgetStatus(
            x.Category!.Name, x.Category.Color, x.Limit,
            spentByCategory.GetValueOrDefault(x.CategoryId))).ToList();

        var firstChartMonth = monthStart.AddMonths(-5);
        var chartTransactions = await db.Transactions
            .AsNoTracking()
            .Where(x => x.UserId == userId &&
                        x.Category!.Type == TransactionType.Expense &&
                        x.Date >= firstChartMonth && x.Date < nextMonth)
            .Select(x => new { x.Date, x.Amount })
            .ToListAsync();
        var monthlyTotals = chartTransactions
            .GroupBy(x => new DateOnly(x.Date.Year, x.Date.Month, 1))
            .ToDictionary(x => x.Key, x => x.Sum(t => t.Amount));
        monthlyExpenses = Enumerable.Range(0, 6)
            .Select(offset => firstChartMonth.AddMonths(offset))
            .Select(month => new MonthlyExpense(month, monthlyTotals.GetValueOrDefault(month)))
            .ToList();

        recentTransactions = await db.Transactions
            .AsNoTracking()
            .Include(x => x.Category)
            .Where(x => x.UserId == userId)
            .OrderByDescending(x => x.Date)
            .ThenByDescending(x => x.Id)
            .Take(5)
            .ToListAsync();

        isLoading = false;
    }

    private static string Money(decimal value) => value.ToString("N2") + " ₴";

    private static string MoneyCompact(decimal value) => value switch
    {
        >= 1_000_000 => $"{value / 1_000_000:0.#} млн ₴",
        >= 1_000 => $"{value / 1_000:0.#} тыс. ₴",
        _ => $"{value:0} ₴"
    };

    private int MonthlyBarHeight(decimal value)
    {
        var maximum = monthlyExpenses.Count == 0 ? 0 : monthlyExpenses.Max(x => x.Amount);
        return maximum == 0 || value == 0 ? 0 : Math.Max(4, (int)Math.Round(value / maximum * 100));
    }

    private decimal Percent(decimal value)
    {
        var maximum = expensesByCategory.Count == 0 ? 0 : expensesByCategory.Max(x => x.Amount);
        return maximum == 0 ? 0 : Math.Round(value / maximum * 100, 1);
    }

    private sealed record CategoryTotal(string Name, string Color, decimal Amount);

    private sealed record MonthlyExpense(DateOnly Month, decimal Amount)
    {
        public string Label => Month.ToString("MMM");
        public string FullLabel => Month.ToString("MMMM yyyy");
    }

    private sealed record BudgetStatus(string CategoryName, string Color, decimal Limit, decimal Spent)
    {
        public decimal Percent => Limit == 0 ? 0 : Math.Round(Spent / Limit * 100, 0);
        public decimal ProgressWidth => Math.Min(Percent, 100);
        public bool IsExceeded => Spent > Limit;
        public bool IsNearLimit => !IsExceeded && Percent >= 80;
        public string BarColor => IsExceeded ? "#c43d3d" : IsNearLimit ? "#d78b19" : Color;
        public string StatusText => IsExceeded
            ? $"Превышение на {Money(Spent - Limit)}"
            : $"{Money(Spent)} из {Money(Limit)}";
    }
}
