@page "/account/forgot-password-confirmation"
@layout AccountLayout

<PageTitle>Проверьте почту — Мои финансы</PageTitle>

<section class="account-card account-result">
    <div class="account-result-icon">✉</div>
    <p class="eyebrow">Восстановление пароля</p>
    <h1>Проверьте почту</h1>
    <p class="subtitle">Если аккаунт с таким подтверждённым email существует, мы отправили ссылку для смены пароля.</p>
    <a class="button secondary" href="/account/login">Вернуться ко входу</a>
</section>
