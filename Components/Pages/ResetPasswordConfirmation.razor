@page "/account/reset-password-confirmation"
@layout AccountLayout

<PageTitle>Пароль изменён — Мои финансы</PageTitle>

<section class="account-card account-result">
    <div class="account-result-icon">✓</div>
    <p class="eyebrow">Готово</p>
    <h1>Пароль изменён</h1>
    <p class="subtitle">Теперь можно войти в аккаунт с новым паролем.</p>
    <a class="button primary" href="/account/login">Войти</a>
</section>
