@page "/account/forgot-password"
@layout AccountLayout

<PageTitle>Восстановление пароля — Мои финансы</PageTitle>

<section class="account-card">
    <p class="eyebrow">Доступ к аккаунту</p>
    <h1>Забыли пароль?</h1>
    <p class="subtitle">Введите подтверждённый email — мы отправим ссылку для создания нового пароля.</p>

    <form class="stacked-form account-form" method="post" action="/account/actions/forgot-password">
        <AntiforgeryToken />
        <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required autofocus />
        </label>
        <button class="button primary" type="submit">Получить ссылку</button>
    </form>

    <p class="account-switch"><a href="/account/login">Вернуться ко входу</a></p>
</section>
