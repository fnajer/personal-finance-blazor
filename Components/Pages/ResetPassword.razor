@page "/account/reset-password"
@layout AccountLayout

<PageTitle>Новый пароль — Мои финансы</PageTitle>

<section class="account-card">
    <p class="eyebrow">Восстановление пароля</p>
    <h1>Задайте новый пароль</h1>
    <p class="subtitle">После сохранения используйте новый пароль для входа.</p>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert error account-alert">@Error</div>
    }

    @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
    {
        <div class="alert error account-alert">Ссылка неполная или повреждена. Запросите новую.</div>
        <a class="button primary account-result-action" href="/account/forgot-password">Запросить новую ссылку</a>
    }
    else
    {
        <form class="stacked-form account-form" method="post" action="/account/actions/reset-password">
            <AntiforgeryToken />
            <input type="hidden" name="email" value="@Email" />
            <input type="hidden" name="code" value="@Code" />
            <label>
                <span>Новый пароль</span>
                <input type="password" name="password" autocomplete="new-password" minlength="8" required autofocus />
                <small class="field-hint">Не менее 8 символов, с заглавной и строчной буквой и цифрой.</small>
            </label>
            <label>
                <span>Повторите пароль</span>
                <input type="password" name="passwordConfirmation" autocomplete="new-password" minlength="8" required />
            </label>
            <button class="button primary" type="submit">Сохранить пароль</button>
        </form>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
